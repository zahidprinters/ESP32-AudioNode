# --- build / tooling artifacts -------------------------------------------
build/
dist/
*.egg-info/
.venv/
venv/
sdkconfig.old
firmware/managed_components/
__pycache__/
*.pyc

# --- session logs (local scratch, never committed) -------------------------
# Curated conclusions live in CHANGELOG.md and docs/PROJECT_STATE.md.
# Raw transcripts carry private LAN addresses and the lab SSID.
logs/*
!logs/README.md

# --- media ------------------------------------------------------------------
# Audio content is local: audio_player/config.py recreates the folder on import.
audio_player/media/

# --- user state -------------------------------------------------------------
# EQ presets and the node list are per-user (created by the app at runtime).
audio_player/eq_presets.json
audio_player/nodes.json
audio_player/settings.json

# --- scratch ---------------------------------------------------------------
# tmp/ is disposable: experiments, dumps, throwaway scripts.
tmp/
temp/
test-results/
.playwright-mcp/
.pytest_cache/
