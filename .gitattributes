# Normalize line endings: LF in the repository, on every platform.
# Without this, a Windows checkout converts to CRLF and re-adds files as modified.
* text=auto eol=lf

# Windows batch files must keep CRLF in the working tree: cmd.exe parses
# labels and parenthesised blocks by line, and LF-only files misbehave.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never convert, never diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.wav  binary
*.bin  binary
*.elf  binary
*.pdf  binary

# Keep GitHub language stats honest.
logs/*.md linguist-documentation
docs/*.md linguist-documentation